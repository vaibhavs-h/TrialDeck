{
  "name": "clinical-trial-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Clinical Trial Operations Hub - Forge app for Jira, Confluence and Rovo (Codegeist 2026)",
  "scripts": {
    "install:all": "npm install && npm --prefix static/dashboard install",
